### Authentication ###

# Your Garmin authentication token (see README_AUTH_SETUP.md).
GARMIN_AUTH_TOKEN=CHANGEME

# Your Notion API token.
NOTION_TOKEN=CHANGEME
# The ID of your Notion database for steps.
NOTION_DB_ID_STEPS=CHANGEME
# The ID of your Notion database for activities.
NOTION_DB_ID=CHANGEME
# The ID of your Notion database for personal records.
NOTION_PR_DB_ID=CHANGEME
# The ID of your Notion Training Calendar database (optional).
NOTION_CALENDAR_DB_ID=CHANGEME

### Configuration ###

# The maximum number of activities to fetch from Garmin
GARMIN_ACTIVITIES_FETCH_LIMIT=10
# IANA timezone used to decide which month/day to sync.
TRAINING_CALENDAR_TIMEZONE=America/New_York
